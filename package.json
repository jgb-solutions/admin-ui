{
  "name": "@jgb-solutions/admin",
  "version": "0.1.4",
  "description": "The admin panel kit for JGB Solutions apps: a React shell, data blocks, forms and SVG charts, styled once, accessible, phone-ready, light and dark.",
  "license": "MIT",
  "author": "JGB Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgb-solutions/admin-ui.git"
  },
  "homepage": "https://github.com/jgb-solutions/admin-ui#readme",
  "bugs": "https://github.com/jgb-solutions/admin-ui/issues",
  "keywords": [
    "admin",
    "dashboard",
    "react",
    "bento",
    "design-system",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check",
    "test": "bun test src",
    "test:e2e": "bun --bun playwright test",
    "playground": "bun playground/serve.ts",
    "screenshots": "bun --bun playwright test e2e/screenshots.spec.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "check:package": "bun scripts/check-package.ts",
    "check:install": "bun scripts/check-install.ts",
    "prepublishOnly": "bun run build && bun run check:package"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
